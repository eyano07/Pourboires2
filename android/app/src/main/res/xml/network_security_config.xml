<?xml version="1.0" encoding="utf-8"?>
<!-- Le serveur est en HTTP (adresse IP) : Android bloque ce trafic par défaut, on l'autorise ici. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
